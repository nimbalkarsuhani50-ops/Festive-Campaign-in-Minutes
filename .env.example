# GEMINI_API_KEY: required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional cascade models. The small model is tried first; the larger one only if it fails validation.
# GEMINI_SMALL_MODEL="gemini-3.8-flash-lite"
# GEMINI_MODEL="gemini-3.8-flash"

# PORT: optional. Defaults to 3000.
# PORT=3000
